var content = File.read("data.csv")
var lines = content.split("\n")
var records = List(List(str))()

for line in lines
    if line.trim().len == 0
        continue

    var fields = line.split(",")
    records.add(fields)

for record in records
    print(record)  # Each field: record.at(0), record.at(1), etc.