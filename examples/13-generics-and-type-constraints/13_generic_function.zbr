# file: 13_generic_function.zbr
# teaches: top-level generic function declaration
# chapter: 13-Generics-and-Type-Constraints

def identity(T)(value: T): T
    return value

def first(T)(items: List(T)): T?
    if items.count() == 0
        return nil
    return items.at(0)

def main()
    var n: int = identity(int)(42)
    var s: str = identity(str)("hello")
    var first_num: int? = first(int)([1, 2, 3])
    if first_num as v
        print(v)  # 1
    print(s)      # hello