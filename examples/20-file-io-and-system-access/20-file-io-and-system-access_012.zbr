# Client:
def main()
    var conn = Tcp.connect("example.com", 80)
    conn.send("GET / HTTP/1.0\r\nHost: example.com\r\n\r\n")
    var response = conn.recv(4096)
    print(response)
    conn.close()

# Server:
def main()
    Tcp.serve(8080, def(conn)
        var msg = conn.recv(1024)
        conn.send("echo: ${msg}")
        conn.close()
    )