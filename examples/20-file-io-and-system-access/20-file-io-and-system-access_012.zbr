# Client:
def main()
    var conn = Tcp.connect("example.com", 80)
    conn.write("GET / HTTP/1.0\r\nHost: example.com\r\n\r\n")
    var response = conn.readAll()
    print(response)
    conn.close()

# Server:
def main()
    Tcp.serve(8080, def(conn)
        var msg = conn.read()
        conn.write("echo: ${msg}")
        conn.close()
    )