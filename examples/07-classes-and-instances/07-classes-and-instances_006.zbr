@derive(Debug, Eq, Hash)
struct Point
    var x: float
    var y: float

def main()
    var p = Point(x: 1.0, y: 2.0)
    var q = Point(x: 1.0, y: 2.0)
    print(p.toString())  # "Point(x=1.0, y=2.0)"
    print(p.equals(q))  # true (and p == q routes through it)
    print(p.hash() == q.hash())  # true