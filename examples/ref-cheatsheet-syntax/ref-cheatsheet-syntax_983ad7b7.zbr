# Tier 1: static field/type-name arrays:
class User
    var name: str = ""
    var age: int = 0

print(Reflect.className(u))  # "User"
for n in Reflect.fieldNames(u)
    print(n)

# Tier 3: strict JSON deserialization
@reflectable
class User
    var name: str = ""
    var age: int = 0

if Json.parseStrict(User, src) as u
    print(u.name)