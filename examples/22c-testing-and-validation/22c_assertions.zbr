# file: 22c_assertions.zbr
# teaches: assert on comparisons, and what its failure says
# chapter: 22c-Testing-and-Validation

def test_equality()
    assert 1 + 1 == 2
    assert "hello" == "hello"
    assert [1, 2, 3].count() == 3

def test_inequality()
    assert 1 != 2
    assert "foo" != "bar"

def test_booleans()
    assert 5 > 3
    assert not false
    assert not (1 > 2)
    assert not ("x".len == 0)