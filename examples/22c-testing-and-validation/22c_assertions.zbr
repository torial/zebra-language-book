# file: 22c_assertions.zbr
# teaches: the four assertion forms
# chapter: 22c-Testing-and-Validation

def test_equality()
    assert_eq 1 + 1, 2
    assert_eq "hello", "hello"
    assert_eq [1, 2, 3].count(), 3

def test_inequality()
    assert_ne 1, 2
    assert_ne "foo", "bar"

def test_booleans()
    assert_true  5 > 3
    assert_true  not false
    assert_false 1 > 2
    assert_false "x".len == 0