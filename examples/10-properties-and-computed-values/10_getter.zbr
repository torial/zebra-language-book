# file: 10_getter.zbr
# teaches: computed properties
# chapter: 10-Properties-and-Computed-Values

class Person
    var birth_year: int = 2000
    
    def age: int
        return 2024 - birth_year
    
    def name_length: int
        var name = "Alice"
        return name.len

def main()
    var person = Person()
    person.birth_year = 1990
    print(person.age())  # 34
    print(person.name_length())  # 5