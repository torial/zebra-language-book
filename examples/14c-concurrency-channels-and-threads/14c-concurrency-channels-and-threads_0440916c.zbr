def do_work()
    sys.sleep(20)                # stand-in for real work

def main()
    var done: Atomic(bool) = Atomic(bool)(false)

    sys.go(def()
        capture
            var done: Atomic(bool) = done
        do_work()
        done.store(true)
    )

    while not done.load()
        sys.sleep(10)

    print("worker finished")