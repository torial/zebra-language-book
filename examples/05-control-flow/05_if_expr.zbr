# file: 05_if_expr.zbr
# teaches: if-expression
# chapter: 05-Control-Flow

def main()
    var score = 85

    # Choose a value:
    var verdict = if(score >= 60, "pass", "fail")
    print(verdict)  # pass

    # Use it directly as an argument:
    print(if(score > 90, "excellent", "good"))  # good

    # Absolute value:
    var n: int = -5
    var abs_n: int = if(n >= 0, n, -n)
    print(abs_n)  # 5