# file: 05_match_type.zbr
# teaches: type-based matching with unions
# chapter: 05-Control-Flow

union Pet
    dog: str       # name
    cat: str       # name
    fish: str      # tank-size

def main()
    var pet: Pet = Pet.dog("Rex")

    branch pet
        on Pet.dog as name
            print("${name} says: Woof!")
        on Pet.cat as name
            print("${name} says: Meow!")
        on Pet.fish as size
            print("tank: ${size}")
        else
            pass