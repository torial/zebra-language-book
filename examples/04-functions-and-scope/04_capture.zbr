# file: 04_capture.zbr
# teaches: capture blocks
# chapter: 04-Functions-and-Scope

def make_counter(): def(): int
    var count: int = 0
    return def(): int
        capture
            var count: int = count
        count = count + 1
        return count

def main()
    var counter = make_counter()
    print(counter())  # 1
    print(counter())  # 2
    print(counter())  # 3