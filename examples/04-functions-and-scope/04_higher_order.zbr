# file: 04_higher_order.zbr
# teaches: functions as arguments
# chapter: 04-Functions-and-Scope

def map_int(items: List(int), transform: def(int): int): List(int)
    var result = List(int)()
    for item in items
        result.add(transform(item))
    return result

def main()
    var nums = List(int)()
    nums.add(1)
    nums.add(2)
    nums.add(3)

    var double_it = def(x: int): int = x * 2
    var doubled = map_int(nums, double_it)

    for d in doubled
        print(d)  # 2, 4, 6