# file: 11_unwrap_or.zbr
# teaches: safe unwrapping
# chapter: 11-Nil-Tracking-and-Safety

def get_user_name(user_id: int): str?
    if user_id == 1
        return "Alice"
    return nil

def main()
    var maybe_name = get_user_name(1)

    # Option 1: Check and use default
    if maybe_name as name
        print(name)
    else
        print("Unknown user")

    # Option 2: `orelse` supplies a fallback when the value is nil
    var safe_name = get_user_name(2) orelse "Guest"
    print(safe_name)  # Guest