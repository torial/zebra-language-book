# file: 11_unwrap.zbr
# teaches: force-unwrap operator
# chapter: 11-Nil-Tracking-and-Safety

def main()
    var name: str? = "Alice"
    
    # Unwrap: assert it's not nil
    var safe_name = name!
    print(safe_name)  # Now just str
    
    # If it WAS nil, this would crash
    var empty: str? = nil
    # var crash = empty!  # ❌ Would panic at runtime